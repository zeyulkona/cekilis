PORT=3000

# Postgres connection string. On Vercel: add the "Postgres" (Neon) storage
# integration from the project's Storage tab — it sets POSTGRES_URL for you
# automatically. For local dev, point this at your own Postgres instance.
POSTGRES_URL=postgres://user:password@localhost:5432/cekilis

# Vercel Blob read/write token. On Vercel: add the "Blob" storage
# integration from the project's Storage tab — it sets this for you
# automatically. Required for PDF ticket uploads/downloads.
BLOB_READ_WRITE_TOKEN=REPLACE_WITH_VERCEL_BLOB_TOKEN

# Generate with: openssl rand -hex 24
ADMIN_SECRET_PATH=REPLACE_WITH_LONG_RANDOM_TOKEN
COOKIE_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
