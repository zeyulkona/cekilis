<!doctype html>
<html lang="tr">
<head>
  <%- include('../partials/head', { title: event.name }) %>
</head>
<body>
  <div class="page focus-screen">
    <p><span class="badge-winner">Hoş geldin, <%= maskedName %></span></p>
    <h2><%= event.name %></h2>
    <p><%= slot.day_label %> — <%= slot.time_label %></p>

    <div
      id="timer-ring"
      class="timer-ring"
      data-expires-at="<%= claim.expires_at.replace(' ', 'T') %>Z"
      data-lock-minutes="<%= lockMinutes %>"
    >
      <span id="timer-text">5:00</span>
    </div>
    <p>Bu süre içinde onaylamazsanız slot tekrar herkese açılır.</p>

    <div style="display:flex; gap:12px;">
      <form method="POST" action="/slot/<%= slot.id %>/onayla">
        <button type="submit" class="button-primary">Bileti Onayla ve İndir</button>
      </form>
      <form method="POST" action="/slot/<%= slot.id %>/vazgec">
        <button type="submit" class="button-secondary">Vazgeç</button>
      </form>
    </div>
  </div>

  <script src="/js/countdown.js"></script>
</body>
</html>
